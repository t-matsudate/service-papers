FROM ubuntu:resolute
EXPOSE 80

RUN apt update
RUN apt install -y nginx php-fpm
RUN mv /etc/nginx/nginx.conf /etc/nginx/nginx.conf.old

ADD ./etc/nginx/docker/nginx.conf /etc/nginx/nginx.conf
ADD ./var/www/index.php /var/www/index.php

RUN groupadd nginx
RUN useradd -g nginx nginx
CMD nginx -g "daemon off;"
